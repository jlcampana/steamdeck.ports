# Arreglos nuestros del SDK para Linux (steamdeck-ports), sobre el commit
# del submódulo + el parche del port. Ver games/doax2-linux/README.md.

diff -ru a/src/core/fiber_posix.cpp b/src/core/fiber_posix.cpp
--- a/src/core/fiber_posix.cpp
+++ b/src/core/fiber_posix.cpp
@@ -154,9 +154,15 @@
 #endif  // REX_PLATFORM_ANDROID
 
 void Fiber::Destroy() {
-  // Thread fibers are destroyed from the owning thread itself.
+  // A thread fiber is destroyed by ~XThread, which runs on whichever thread
+  // drops the last reference (e.g. another guest thread closing the handle
+  // of one that has exited). Only clear the current fiber of this thread if
+  // it is this one: clearing another fiber thread's tls_current_ made its
+  // next SwitchTo call swapcontext(nullptr, ...).
   if (is_thread_fiber_) {
-    tls_current_ = nullptr;
+    if (tls_current_ == this) {
+      tls_current_ = nullptr;
+    }
   } else {
     assert(this != tls_current_ && "Destroy called on the currently running fiber");
   }
diff -ru a/src/core/memory_posix.cpp b/src/core/memory_posix.cpp
--- a/src/core/memory_posix.cpp
+++ b/src/core/memory_posix.cpp
@@ -481,6 +481,11 @@
     shm_unlink(full_path.c_str());
     return kFileMappingHandleInvalid;
   }
+  // Nothing opens the mapping by name again (views map the descriptor), so
+  // unlink it now: the memory lives while the descriptor and the views do,
+  // and the name does not stay in /dev/shm when the process ends without
+  // running ~Memory (the title hard-exits; SIGKILL; crashes).
+  shm_unlink(full_path.c_str());
   return static_cast<FileMappingHandle>(ret);
 #endif
 }
