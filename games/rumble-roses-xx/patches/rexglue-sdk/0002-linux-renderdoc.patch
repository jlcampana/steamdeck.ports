# Parche nuestro: no cargar el librenderdoc.so del sistema (SteamOS lo trae) si
# RenderDoc no está conectado. Va después del parche del port y del 0001.
diff -u a/src/ui/renderdoc_api.cpp b/src/ui/renderdoc_api.cpp
--- a/src/ui/renderdoc_api.cpp
+++ b/src/ui/renderdoc_api.cpp
@@ -12,6 +12,12 @@
 #include <rex/logging.h>
 #include <rex/ui/renderdoc_api.h>
 
+#include <rex/platform.h>
+
+#if !REX_PLATFORM_WIN32
+#include <dlfcn.h>
+#endif
+
 namespace rex {
 namespace ui {
 
@@ -25,6 +31,18 @@
 
   pRENDERDOC_GetAPI get_api = nullptr;
 
+#if !REX_PLATFORM_WIN32
+  // Only a RenderDoc already in the process (attached): RTLD_NOLOAD, as Xenia
+  // Canary's renderdoc_api.cc. A plain dlopen loads a system-wide
+  // librenderdoc.so (SteamOS ships one) on every start: its overlay shows up
+  // and the GPU debug markers get enabled.
+  void* attached = dlopen(platform::lib_names::kRenderDoc, RTLD_NOW | RTLD_NOLOAD);
+  if (!attached) {
+    return nullptr;
+  }
+  dlclose(attached);  // the Load below holds its own reference
+#endif
+
   // Try to load the RenderDoc library. If RenderDoc is attached, the library
   // should already be loaded into the process and this will increment the
   // reference count. If not attached, the load will fail and we return nullptr.
