+  case IDR_SETTINGS_CONTROLS:
+    return {lollipop_res_controls_begin, lollipop_res_controls_end};
+  case IDR_MAIN_MENU_QUIT:
+    return {lollipop_res_quit_begin, lollipop_res_quit_end};
+  case 104:
+    return {lollipop_res_pipelines_begin, lollipop_res_pipelines_end};
