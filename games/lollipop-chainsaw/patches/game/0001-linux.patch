+  const auto handle = resource ? LoadResource(module, resource) : nullptr;
+  const auto* data = handle ? static_cast<const uint8_t*>(LockResource(handle)) : nullptr;
+  return data ? std::span(data, SizeofResource(module, resource)) : std::span<const uint8_t>{};
