+#pragma once
+
+// Host helpers with a Windows and a Linux implementation (steamdeck-ports
+// Linux port). Windows keeps using its resources, BCrypt and Win32 calls.
+
+#include <array>
+#include <cstdint>
+#include <filesystem>
+#include <span>
+
+namespace lollipop::platform {
+
+// Data embedded in the executable: the RCDATA resources of assets/lollipop.rc
+// (IDR_* in settings_resources.h, 104 = shaders/pipelines.txt). Empty if absent.
+std::span<const uint8_t> embedded_resource(int id);
+
+std::array<uint8_t, 32> sha256(std::span<const uint8_t> data);
+
+uint32_t process_id();
+
+// Atomically replaces `target` with `source`. Returns false on failure.
+bool replace_file(const std::filesystem::path& source, const std::filesystem::path& target);
+
+// Whether keyboard and mouse prompt artwork can be drawn: it needs GDI+ and
+// Windows' makecab.exe, so on Linux the game keeps its gamepad prompts.
+constexpr bool kKeyboardPromptArtwork =
+#ifdef _WIN32
+    true;
+#else
+    false;
+#endif
+
+// A bold UI font for the PC settings menu (Arial Bold on Windows), or empty.
+std::filesystem::path menu_font();
+
+} // namespace lollipop::platform
