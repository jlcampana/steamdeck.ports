 bool prefetch_recompiled_code() {
+#ifndef _WIN32
+  // Linux: ask the kernel to read in the executable's code segments (the
+  // equivalent of PrefetchVirtualMemory below).
+  struct prefetch_state {
+    size_t bytes = 0;
+    bool failed = false;
+  } state;
+  dl_iterate_phdr(
+      [](dl_phdr_info* info, size_t, void* data) {
+        auto& state = *static_cast<prefetch_state*>(data);
+        const auto page = static_cast<uintptr_t>(sysconf(_SC_PAGESIZE));
+        for (unsigned i = 0; i < info->dlpi_phnum; ++i) {
+          const auto& header = info->dlpi_phdr[i];
+          if (header.p_type != PT_LOAD || !(header.p_flags & PF_X))
+            continue;
+          const auto start = (info->dlpi_addr + header.p_vaddr) & ~(page - 1);
+          const auto end = info->dlpi_addr + header.p_vaddr + header.p_memsz;
+          if (madvise(reinterpret_cast<void*>(start), end - start, MADV_WILLNEED) == 0)
+            state.bytes += end - start;
+          else
+            state.failed = true;
+        }
+        return 1;  // the first object is the executable itself
+      },
+      &state);
+  if (!state.bytes || state.failed) {
+    REXLOG_WARN("Could not prefetch recompiled code");
+    return false;
+  }
+  REXLOG_INFO("Prefetched {} MiB of recompiled code", state.bytes / (1024 * 1024));
+  return true;
+#else
   auto* module = reinterpret_cast<std::byte*>(GetModuleHandleW(nullptr));
   std::vector<WIN32_MEMORY_RANGE_ENTRY> ranges;
   size_t bytes = 0;
@@ -39,6 +77,7 @@ bool prefetch_recompiled_code() {
   }
   REXLOG_INFO("Prefetched {} MiB of recompiled code", bytes / (1024 * 1024));
   return true;
+#endif
 }
 
