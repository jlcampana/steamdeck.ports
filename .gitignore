# Archivos de juego (copias propias, nunca a git)
# isos puede ser un enlace simbólico a otro disco (sin barra final para que lo cubra)
isos
_isos/

# Descargas y estado local de update.sh
latest/
ports.db
.extract.*

# Releases descomprimidas y builds
games/*/latest/
games/*/build/

# Herramientas descargadas por tools/install.sh
tools/bin/

# Build anterior que guarda prepare_build
games/*/build.old/

# Scripts descargados por games/castlevania-son/build.sh
games/castlevania-son/extract_game-*.py

# Paquetes para la Deck (tools/package.sh) y configuración local
dist/
local.conf

# Imágenes de Steam (tools/fetch-art.sh o a mano)
games/*/art/
